
#include <iostream>
#include <string>
#include <fstream>
#include <sstream>
#include <iomanip>
#include <limits>

using namespace std;

const int MAX_CONTAS = 100;
const int MAX_MOVIMENTACOES = 500;

int numeroConta[MAX_CONTAS];
string nomeCliente[MAX_CONTAS];
string cpf[MAX_CONTAS];
int tipoConta[MAX_CONTAS];
double saldo[MAX_CONTAS];
bool contaAtiva[MAX_CONTAS];

int quantidadeContas = 0;

int contaMovimentacao[MAX_MOVIMENTACOES];
char tipoMovimentacao[MAX_MOVIMENTACOES];
double valorMovimentacao[MAX_MOVIMENTACOES];

int quantidadeMovimentacoes = 0;

void carregarContas();
void salvarContas();
void carregarMovimentacoes();
void salvarMovimentacoes();
int localizarConta(int numero);
void registrarMovimentacao(int numero, char tipo, double valor);
void exibirDadosConta(int posicao);

void carregarContas() {
    ifstream arquivo("contas.txt");
    string linha;

    if (arquivo.is_open()) {
        while (getline(arquivo, linha) && quantidadeContas < MAX_CONTAS) {
            stringstream dados(linha);
            string numero, nome, documento, tipo, valor, situacao;

            getline(dados, numero, ';');
            getline(dados, nome, ';');
            getline(dados, documento, ';');
            getline(dados, tipo, ';');
            getline(dados, valor, ';');
            getline(dados, situacao, ';');

            if (numero.empty() || nome.empty() || documento.empty() ||
                tipo.empty() || valor.empty() || situacao.empty()) {
                continue;
            }

            numeroConta[quantidadeContas] = stoi(numero);
            nomeCliente[quantidadeContas] = nome;
            cpf[quantidadeContas] = documento;
            tipoConta[quantidadeContas] = stoi(tipo);
            saldo[quantidadeContas] = stod(valor);
            contaAtiva[quantidadeContas] = (stoi(situacao) == 1);

            quantidadeContas++;
        }

        arquivo.close();
    }
}

void salvarContas() {
    ofstream arquivo("contas.txt");

    if (arquivo.is_open()) {
        arquivo << fixed << setprecision(2);

        for (int i = 0; i < quantidadeContas; i++) {
            arquivo << numeroConta[i] << ";"
                    << nomeCliente[i] << ";"
                    << cpf[i] << ";"
                    << tipoConta[i] << ";"
                    << saldo[i] << ";"
                    << contaAtiva[i] << endl;
        }

        arquivo.close();
    } else {
        cout << "Erro ao abrir o arquivo de contas!\n";
    }
}

void carregarMovimentacoes() {
    ifstream arquivo("movimentacoes.txt");
    string linha;

    if (arquivo.is_open()) {
        while (getline(arquivo, linha) &&
               quantidadeMovimentacoes < MAX_MOVIMENTACOES) {
            stringstream dados(linha);
            string numero, tipo, valor;

            getline(dados, numero, ';');
            getline(dados, tipo, ';');
            getline(dados, valor, ';');

            if (numero.empty() || tipo.empty() || valor.empty()) {
                continue;
            }

            contaMovimentacao[quantidadeMovimentacoes] = stoi(numero);
            tipoMovimentacao[quantidadeMovimentacoes] = tipo[0];
            valorMovimentacao[quantidadeMovimentacoes] = stod(valor);

            quantidadeMovimentacoes++;
        }

        arquivo.close();
    }
}

void salvarMovimentacoes() {
    ofstream arquivo("movimentacoes.txt");

    if (arquivo.is_open()) {
        arquivo << fixed << setprecision(2);

        for (int i = 0; i < quantidadeMovimentacoes; i++) {
            arquivo << contaMovimentacao[i] << ";"
                    << tipoMovimentacao[i] << ";"
                    << valorMovimentacao[i] << endl;
        }

        arquivo.close();
    } else {
        cout << "Erro ao abrir o arquivo de movimentacoes!\n";
    }
}

int localizarConta(int numero) {
    for (int i = 0; i < quantidadeContas; i++) {
        if (numeroConta[i] == numero) {
            return i;
        }
    }

    return -1;
}

void registrarMovimentacao(int numero, char tipo, double valor) {
    if (quantidadeMovimentacoes < MAX_MOVIMENTACOES) {
        contaMovimentacao[quantidadeMovimentacoes] = numero;
        tipoMovimentacao[quantidadeMovimentacoes] = tipo;
        valorMovimentacao[quantidadeMovimentacoes] = valor;

        quantidadeMovimentacoes++;

        salvarMovimentacoes();
    }
}

void exibirDadosConta(int posicao) {
    cout << "\n========== DADOS DA CONTA ==========\n";
    cout << "Numero: " << numeroConta[posicao] << endl;
    cout << "Nome: " << nomeCliente[posicao] << endl;
    cout << "CPF: " << cpf[posicao] << endl;

    if (tipoConta[posicao] == 1) {
        cout << "Tipo: Corrente\n";
    } else {
        cout << "Tipo: Poupanca\n";
    }

    cout << "Saldo: R$ " << saldo[posicao] << endl;

    if (contaAtiva[posicao]) {
        cout << "Situacao: Ativa\n";
    } else {
        cout << "Situacao: Inativa\n";
    }

    cout << "====================================\n";
}

int main() {
    int opcao;

    cout << fixed << setprecision(2);

    carregarContas();
    carregarMovimentacoes();

    cout << "\nDados carregados com sucesso!\n";
    cout << "Contas encontradas: " << quantidadeContas << endl;
    cout << "Movimentacoes encontradas: " << quantidadeMovimentacoes << endl;

    do {
        cout << "\n================================\n";
        cout << "          BANCO INF101\n";
        cout << "================================\n";
        cout << "1 - Cadastrar conta\n";
        cout << "2 - Listar contas\n";
        cout << "3 - Consultar conta\n";
        cout << "4 - Verificar saldo\n";
        cout << "5 - Alterar tipo da conta\n";
        cout << "6 - Ativar/Desativar conta\n";
        cout << "7 - Realizar deposito\n";
        cout << "8 - Realizar saque\n";
        cout << "9 - Realizar transferencia\n";
        cout << "10 - Exibir extrato\n";
        cout << "11 - Sair\n";
        cout << "================================\n";
        cout << "Digite uma opcao: ";
        cin >> opcao;

        switch (opcao) {

        case 1: {
            if (quantidadeContas == MAX_CONTAS) {
                cout << "\nLimite de contas atingido!\n";
                break;
            }

            int numero;
            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            if (numero <= 0) {
                cout << "O numero deve ser maior que zero!\n";
                break;
            }

            if (localizarConta(numero) != -1) {
                cout << "Essa conta ja existe!\n";
                break;
            }

            numeroConta[quantidadeContas] = numero;

            cin.ignore(numeric_limits<streamsize>::max(), '\n');

            cout << "Digite o nome do cliente: ";
            getline(cin, nomeCliente[quantidadeContas]);

            cout << "Digite o CPF: ";
            getline(cin, cpf[quantidadeContas]);

            do {
                cout << "\nTipo da conta:\n";
                cout << "1 - Corrente\n";
                cout << "2 - Poupanca\n";
                cout << "Digite: ";
                cin >> tipoConta[quantidadeContas];

                if (tipoConta[quantidadeContas] != 1 &&
                    tipoConta[quantidadeContas] != 2) {
                    cout << "Tipo invalido!\n";
                }
            } while (tipoConta[quantidadeContas] != 1 &&
                     tipoConta[quantidadeContas] != 2);

            do {
                cout << "Digite o saldo inicial: R$ ";
                cin >> saldo[quantidadeContas];

                if (saldo[quantidadeContas] < 0) {
                    cout << "O saldo nao pode ser negativo!\n";
                }
            } while (saldo[quantidadeContas] < 0);

            contaAtiva[quantidadeContas] = true;
            quantidadeContas++;

            salvarContas();

            cout << "\nConta cadastrada e salva com sucesso!\n";
            break;
        }

        case 2: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            cout << "\n========== CONTAS CADASTRADAS ==========\n";

            for (int i = 0; i < quantidadeContas; i++) {
                exibirDadosConta(i);
            }

            break;
        }

        case 3: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
            } else {
                exibirDadosConta(posicao);
            }

            break;
        }

        case 4: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
            } else if (!contaAtiva[posicao]) {
                cout << "A conta esta desativada!\n";
            } else {
                cout << "Saldo: R$ " << saldo[posicao] << endl;
            }

            break;
        }

        case 5: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            int novoTipo;

            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
                break;
            }

            if (!contaAtiva[posicao]) {
                cout << "A conta esta desativada!\n";
                break;
            }

            do {
                cout << "\nNovo tipo:\n";
                cout << "1 - Corrente\n";
                cout << "2 - Poupanca\n";
                cout << "Digite: ";
                cin >> novoTipo;

                if (novoTipo != 1 && novoTipo != 2) {
                    cout << "Tipo invalido!\n";
                }
            } while (novoTipo != 1 && novoTipo != 2);

            tipoConta[posicao] = novoTipo;
            salvarContas();

            cout << "Tipo da conta alterado e salvo!\n";
            break;
        }

        case 6: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
            } else {
                if (contaAtiva[posicao]) {
                    contaAtiva[posicao] = false;
                    cout << "Conta desativada!\n";
                } else {
                    contaAtiva[posicao] = true;
                    cout << "Conta ativada!\n";
                }

                salvarContas();
            }

            break;
        }

        case 7: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            double valor;

            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
                break;
            }

            if (!contaAtiva[posicao]) {
                cout << "A conta esta desativada!\n";
                break;
            }

            if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                cout << "Limite de movimentacoes atingido!\n";
                break;
            }

            cout << "Digite o valor do deposito: R$ ";
            cin >> valor;

            if (valor <= 0) {
                cout << "O valor deve ser positivo!\n";
                break;
            }

            saldo[posicao] += valor;

            registrarMovimentacao(numeroConta[posicao], 'D', valor);
            salvarContas();

            cout << "\nDeposito realizado com sucesso!\n";
            cout << "Novo saldo: R$ " << saldo[posicao] << endl;
            break;
        }

        case 8: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            double valor;

            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
                break;
            }

            if (!contaAtiva[posicao]) {
                cout << "A conta esta desativada!\n";
                break;
            }

            if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                cout << "Limite de movimentacoes atingido!\n";
                break;
            }

            cout << "Digite o valor do saque: R$ ";
            cin >> valor;

            if (valor <= 0) {
                cout << "O valor deve ser positivo!\n";
                break;
            }

            if (saldo[posicao] < valor) {
                cout << "Saldo insuficiente!\n";
                break;
            }

            saldo[posicao] -= valor;

            registrarMovimentacao(numeroConta[posicao], 'S', valor);
            salvarContas();

            cout << "\nSaque realizado com sucesso!\n";
            cout << "Novo saldo: R$ " << saldo[posicao] << endl;
            break;
        }

        case 9: {
            if (quantidadeContas < 2) {
                cout << "\nSao necessarias pelo menos duas contas!\n";
                break;
            }

            int origem, destino;
            double valor;

            cout << "\nDigite o numero da conta de origem: ";
            cin >> origem;

            cout << "Digite o numero da conta de destino: ";
            cin >> destino;

            int indiceOrigem = localizarConta(origem);
            int indiceDestino = localizarConta(destino);

            if (indiceOrigem == -1 || indiceDestino == -1) {
                cout << "Uma das contas nao foi encontrada!\n";
                break;
            }

            if (indiceOrigem == indiceDestino) {
                cout << "Nao e possivel transferir para a mesma conta!\n";
                break;
            }

            if (!contaAtiva[indiceOrigem] ||
                !contaAtiva[indiceDestino]) {
                cout << "As duas contas precisam estar ativas!\n";
                break;
            }

            if (quantidadeMovimentacoes + 2 > MAX_MOVIMENTACOES) {
                cout << "Nao ha espaco para registrar a transferencia!\n";
                break;
            }

            cout << "Digite o valor da transferencia: R$ ";
            cin >> valor;

            if (valor <= 0) {
                cout << "O valor deve ser positivo!\n";
                break;
            }

            if (saldo[indiceOrigem] < valor) {
                cout << "Saldo insuficiente!\n";
                break;
            }

            saldo[indiceOrigem] -= valor;
            saldo[indiceDestino] += valor;

            registrarMovimentacao(origem, 'S', valor);
            registrarMovimentacao(destino, 'D', valor);

            salvarContas();

            cout << "\nTransferencia realizada com sucesso!\n";
            cout << "Saldo da conta de origem: R$ "
                 << saldo[indiceOrigem] << endl;
            cout << "Saldo da conta de destino: R$ "
                 << saldo[indiceDestino] << endl;

            break;
        }

        case 10: {
            if (quantidadeContas == 0) {
                cout << "\nNenhuma conta cadastrada!\n";
                break;
            }

            int numero;
            bool encontrouMovimentacao = false;

            cout << "\nDigite o numero da conta: ";
            cin >> numero;

            int posicao = localizarConta(numero);

            if (posicao == -1) {
                cout << "Conta nao encontrada!\n";
                break;
            }

            cout << "\n========== EXTRATO ==========\n";
            cout << "Conta: " << numeroConta[posicao] << endl;
            cout << "Cliente: " << nomeCliente[posicao] << endl;
            cout << "Movimentacoes:\n";

            for (int i = 0; i < quantidadeMovimentacoes; i++) {
                if (contaMovimentacao[i] == numeroConta[posicao]) {
                    encontrouMovimentacao = true;

                    if (tipoMovimentacao[i] == 'D') {
                        cout << "Deposito/Entrada: R$ "
                             << valorMovimentacao[i] << endl;
                    } else if (tipoMovimentacao[i] == 'S') {
                        cout << "Saque/Saida: R$ "
                             << valorMovimentacao[i] << endl;
                    }
                }
            }

            if (!encontrouMovimentacao) {
                cout << "Nenhuma movimentacao encontrada!\n";
            }

            cout << "-----------------------------\n";
            cout << "Saldo atual: R$ " << saldo[posicao] << endl;
            cout << "=============================\n";

            break;
        }

        case 11:
            cout << "\nPrograma encerrado!\n";
            break;

        default:
            cout << "\nOpcao invalida!\n";
        }

    } while (opcao != 11);

    return 0;
}
