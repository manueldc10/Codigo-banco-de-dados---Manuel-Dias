
#include <iostream>
#include <iomanip>
#include <string>
#include <limits>

using namespace std;

// Limites definidos pelo professor
const int MAX_CONTAS = 100;
const int MAX_MOVIMENTACOES = 500;

// Arrays das contas
int numeroConta[MAX_CONTAS];
string nomeCliente[MAX_CONTAS];
string cpf[MAX_CONTAS];
int tipoConta[MAX_CONTAS];
double saldo[MAX_CONTAS];
bool contaAtiva[MAX_CONTAS];

int quantidadeContas = 0;

// Arrays do historico de movimentacoes
int contaMovimentacao[MAX_MOVIMENTACOES];
char tipoMovimentacao[MAX_MOVIMENTACOES];
double valorMovimentacao[MAX_MOVIMENTACOES];

int quantidadeMovimentacoes = 0;

// Buscar uma conta pelo numero
int buscarConta(int numero) {
    for (int i = 0; i < quantidadeContas; i++) {
        if (numeroConta[i] == numero) {
            return i;
        }
    }

    return -1;
}

// Cadastrar uma nova conta
void cadastrarConta() {
    if (quantidadeContas >= MAX_CONTAS) {
        cout << "\nLimite maximo de contas atingido!\n";
        return;
    }

    int numero;

    cout << "\n===== CADASTRAR CONTA =====\n";

    cout << "Numero da conta: ";
    cin >> numero;

    if (buscarConta(numero) != -1) {
        cout << "Este numero de conta ja existe!\n";
        return;
    }

    if (numero <= 0) {
        cout << "Numero de conta invalido!\n";
        return;
    }

    numeroConta[quantidadeContas] = numero;

    cin.ignore(numeric_limits<streamsize>::max(), '\n');

    cout << "Nome do cliente: ";
    getline(cin, nomeCliente[quantidadeContas]);

    cout << "CPF: ";
    getline(cin, cpf[quantidadeContas]);

    cout << "\nTipo de conta:\n";
    cout << "1 - Conta Corrente\n";
    cout << "2 - Conta Poupanca\n";
    cout << "Escolha: ";
    cin >> tipoConta[quantidadeContas];

    if (tipoConta[quantidadeContas] != 1 &&
        tipoConta[quantidadeContas] != 2) {
        cout << "Tipo de conta invalido!\n";
        return;
    }

    saldo[quantidadeContas] = 0.0;
    contaAtiva[quantidadeContas] = true;

    quantidadeContas++;

    cout << "\nConta cadastrada com sucesso!\n";
}

// Listar todas as contas
void listarContas() {
    cout << "\n===== CONTAS CADASTRADAS =====\n";

    if (quantidadeContas == 0) {
        cout << "Nenhuma conta cadastrada.\n";
        return;
    }

    for (int i = 0; i < quantidadeContas; i++) {

        cout << "\nNumero: " << numeroConta[i];
        cout << "\nCliente: " << nomeCliente[i];
        cout << "\nCPF: " << cpf[i];

        if (tipoConta[i] == 1) {
            cout << "\nTipo: Conta Corrente";
        } else {
            cout << "\nTipo: Conta Poupanca";
        }

        cout << fixed << setprecision(2);
        cout << "\nSaldo: R$ " << saldo[i];

        cout << "\nSituacao: "
             << (contaAtiva[i] ? "Ativa" : "Inativa");

        cout << "\n-----------------------------\n";
    }
}

// Consultar uma conta
void consultarConta() {
    int numero;

    cout << "\n===== CONSULTAR CONTA =====\n";
    cout << "Digite o numero da conta: ";
    cin >> numero;

    int indice = buscarConta(numero);

    if (indice == -1) {
        cout << "Conta nao encontrada!\n";
        return;
    }

    cout << "\nNumero: " << numeroConta[indice];
    cout << "\nCliente: " << nomeCliente[indice];
    cout << "\nCPF: " << cpf[indice];

    if (tipoConta[indice] == 1) {
        cout << "\nTipo: Conta Corrente";
    } else {
        cout << "\nTipo: Conta Poupanca";
    }

    cout << fixed << setprecision(2);
    cout << "\nSaldo: R$ " << saldo[indice];

    cout << "\nSituacao: "
         << (contaAtiva[indice] ? "Ativa" : "Inativa");

    cout << "\n";
}

// Realizar deposito
void depositar() {
    int numero;
    double valor;

    cout << "\n===== DEPOSITO =====\n";
    cout << "Numero da conta: ";
    cin >> numero;

    int indice = buscarConta(numero);

    if (indice == -1) {
        cout << "Conta nao encontrada!\n";
        return;
    }

    if (!contaAtiva[indice]) {
        cout << "Conta inativa!\n";
        return;
    }

    cout << "Valor do deposito: R$ ";
    cin >> valor;

    if (valor <= 0) {
        cout << "Valor invalido!\n";
        return;
    }

    if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
        cout << "Limite de movimentacoes atingido!\n";
        return;
    }

    saldo[indice] += valor;

    contaMovimentacao[quantidadeMovimentacoes] =
        numeroConta[indice];

    tipoMovimentacao[quantidadeMovimentacoes] = 'D';

    valorMovimentacao[quantidadeMovimentacoes] = valor;

    quantidadeMovimentacoes++;

    cout << fixed << setprecision(2);
    cout << "\nDeposito realizado com sucesso!";
    cout << "\nNovo saldo: R$ " << saldo[indice] << "\n";
}

// Realizar saque
void sacar() {
    int numero;
    double valor;

    cout << "\n===== SAQUE =====\n";
    cout << "Numero da conta: ";
    cin >> numero;

    int indice = buscarConta(numero);

    if (indice == -1) {
        cout << "Conta nao encontrada!\n";
        return;
    }

    if (!contaAtiva[indice]) {
        cout << "Conta inativa!\n";
        return;
    }

    cout << "Valor do saque: R$ ";
    cin >> valor;

    if (valor <= 0) {
        cout << "Valor invalido!\n";
        return;
    }

    if (valor > saldo[indice]) {
        cout << "Saldo insuficiente!\n";
        return;
    }

    if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
        cout << "Limite de movimentacoes atingido!\n";
        return;
    }

    saldo[indice] -= valor;

    contaMovimentacao[quantidadeMovimentacoes] =
        numeroConta[indice];

    tipoMovimentacao[quantidadeMovimentacoes] = 'S';

    valorMovimentacao[quantidadeMovimentacoes] = valor;

    quantidadeMovimentacoes++;

    cout << fixed << setprecision(2);
    cout << "\nSaque realizado com sucesso!";
    cout << "\nNovo saldo: R$ " << saldo[indice] << "\n";
}

// Realizar transferencia
void transferir() {
    int origem, destino;
    double valor;

    cout << "\n===== TRANSFERENCIA =====\n";

    cout << "Conta de origem: ";
    cin >> origem;

    int indiceOrigem = buscarConta(origem);

    if (indiceOrigem == -1) {
        cout << "Conta de origem nao encontrada!\n";
        return;
    }

    if (!contaAtiva[indiceOrigem]) {
        cout << "Conta de origem inativa!\n";
        return;
    }

    cout << "Conta de destino: ";
    cin >> destino;

    int indiceDestino = buscarConta(destino);

    if (indiceDestino == -1) {
        cout << "Conta de destino nao encontrada!\n";
        return;
    }

    if (!contaAtiva[indiceDestino]) {
        cout << "Conta de destino inativa!\n";
        return;
    }

    if (indiceOrigem == indiceDestino) {
        cout << "Nao e possivel transferir para a mesma conta!\n";
        return;
    }

    cout << "Valor da transferencia: R$ ";
    cin >> valor;

    if (valor <= 0) {
        cout << "Valor invalido!\n";
        return;
    }

    if (valor > saldo[indiceOrigem]) {
        cout << "Saldo insuficiente!\n";
        return;
    }

    // A transferencia precisa de dois registros
    if (quantidadeMovimentacoes + 2 > MAX_MOVIMENTACOES) {
        cout << "Espaco insuficiente no historico!\n";
        return;
    }

    // Atualizar os saldos
    saldo[indiceOrigem] -= valor;
    saldo[indiceDestino] += valor;

    // Registrar saida da conta de origem
    contaMovimentacao[quantidadeMovimentacoes] = origem;
    tipoMovimentacao[quantidadeMovimentacoes] = 'S';
    valorMovimentacao[quantidadeMovimentacoes] = valor;

    quantidadeMovimentacoes++;

    // Registrar entrada na conta de destino
    contaMovimentacao[quantidadeMovimentacoes] = destino;
    tipoMovimentacao[quantidadeMovimentacoes] = 'D';
    valorMovimentacao[quantidadeMovimentacoes] = valor;

    quantidadeMovimentacoes++;

    cout << fixed << setprecision(2);
    cout << "\nTransferencia realizada com sucesso!";
    cout << "\nNovo saldo da conta de origem: R$ "
         << saldo[indiceOrigem];

    cout << "\nNovo saldo da conta de destino: R$ "
         << saldo[indiceDestino] << "\n";
}

// Exibir extrato
void exibirExtrato() {
    int numero;
    bool encontrou = false;

    cout << "\n===== EXTRATO BANCARIO =====\n";
    cout << "Numero da conta: ";
    cin >> numero;

    int indice = buscarConta(numero);

    if (indice == -1) {
        cout << "Conta nao encontrada!\n";
        return;
    }

    cout << "\nCliente: " << nomeCliente[indice];
    cout << "\nConta: " << numeroConta[indice];
    cout << "\n\nMovimentacoes:\n";

    cout << fixed << setprecision(2);

    for (int i = 0; i < quantidadeMovimentacoes; i++) {

        if (contaMovimentacao[i] == numero) {

            encontrou = true;

            if (tipoMovimentacao[i] == 'D') {
                cout << "Deposito/Entrada: R$ "
                     << valorMovimentacao[i] << "\n";
            }
            else if (tipoMovimentacao[i] == 'S') {
                cout << "Saque/Saida: R$ "
                     << valorMovimentacao[i] << "\n";
            }
        }
    }

    if (!encontrou) {
        cout << "Nenhuma movimentacao encontrada.\n";
    }

    cout << "\nSaldo atual: R$ " << saldo[indice] << "\n";
}

// Programa principal
int main() {

    int opcao;

    do {
        cout << "\n================================\n";
        cout << "       SISTEMA BANCARIO\n";
        cout << "================================\n";

        cout << "1 - Cadastrar conta\n";
        cout << "2 - Listar contas\n";
        cout << "3 - Consultar conta\n";
        cout << "4 - Realizar deposito\n";
        cout << "5 - Realizar saque\n";
        cout << "6 - Realizar transferencia\n";
        cout << "7 - Exibir extrato\n";
        cout << "0 - Sair do sistema\n";

        cout << "================================\n";
        cout << "Escolha uma opcao: ";
        cin >> opcao;

        switch (opcao) {

            case 1:
                cadastrarConta();
                break;

            case 2:
                listarContas();
                break;

            case 3:
                consultarConta();
                break;

            case 4:
                depositar();
                break;

            case 5:
                sacar();
                break;

            case 6:
                transferir();
                break;

            case 7:
                exibirExtrato();
                break;

            case 0:
                cout << "\nEncerrando o sistema...\n";
                break;

            default:
                cout << "\nOpcao invalida! Tente novamente.\n";
        }

    } while (opcao != 0);

    return 0;
}
